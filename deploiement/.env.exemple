# Bureau des Primes — variables du déploiement.
#
#   cp .env.exemple .env    puis remplir, puis :  chmod 600 .env

# --- Adresse ---------------------------------------------------------
# ADRESSE dit à Caddy quoi servir et s'il doit demander un certificat.
#
#   BÊTA, sur l'IP du VPS  ->  ADRESSE=:80
#       Sert en clair, sans rien demander à Let's Encrypt. Obligatoire
#       tant qu'il n'y a pas de domaine : aucune autorité ne certifie
#       une adresse IP.
#
#   EN LIGNE, avec domaine ->  ADRESSE=mon-domaine.fr
#       Caddy obtient et renouvelle le certificat tout seul. Le DNS doit
#       déjà pointer vers le VPS avant de démarrer.
ADRESSE=:80

# L'adresse publique complète, celle que voit le joueur. Elle sert au
# retour de connexion Discord.
#   bêta     http://203.0.113.10        (mettre l'IP du VPS)
#   en ligne https://mon-domaine.fr
URL_PUBLIQUE=http://METTRE-L-IP-DU-VPS

# --- Base de données ------------------------------------------------
# Ces valeurs créent la base au premier lancement. Les changer ensuite
# ne renomme rien : il faudrait supprimer le volume db_data et tout
# reprendre. Choisis-les maintenant.
BD_BASE=bureau_des_primes
BD_UTILISATEUR=primes
BD_MOTDEPASSE=
BD_ROOT=

# --- Application Discord --------------------------------------------
# LAISSER VIDE EN BÊTA. Discord refuse les redirections en clair : sans
# HTTPS la connexion ne peut pas fonctionner. Vides, le bouton disparaît
# et le jeu tourne sans compte, les séries gardées dans le navigateur.
#
# Une fois le domaine et le HTTPS en place :
#   https://discord.com/developers/applications
#   OAuth2 > Redirects, coller EXACTEMENT :
#     https://<domaine>/api/retour.php
DISCORD_ID=
DISCORD_SECRET=

# --- Mode bêta -------------------------------------------------------
# À 1 : le classement et l'historique dorment, et l'avis du jour se
# rejoue sans attendre minuit. Les deux vont ensemble — rejouer à
# volonté viderait le classement de son sens.
# Vide ou absent : le jeu reprend sa forme normale.
BETA=1
